# Copy this file to ".env" and fill in the values. Never commit .env.
# Save the JSON in the gitignored secrets/ folder (or outside the repo) and put its path here,
# relative to the project folder (where backend.py runs). This key IS a secret.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/your-firebase-adminsdk-key.json

# Operator chat (backend.py crashes on startup without it).
OPENAI_API_KEY=your-openai-api-key
